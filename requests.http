### create user (register)
// @no-log
POST localhost:8080/api/v1/user/c
Content-Type: application/json

{
  "username": "admin",
  "password": "password",
  "email": "admin@gmail.com",
  "firstName": "admin"
}

### login
// @no-log
POST localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

